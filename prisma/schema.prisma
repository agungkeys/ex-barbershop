generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  phone           String      @unique
  email           String?     @unique
  password        String?
  avatar          String?
  role            Role        @default(CUSTOMER)
  googleId        String?     @unique
  bookings        Booking[]
  barber          Barber?
  reviews         Review[]
  membership      Membership?
  visits          Int         @default(0)
  freeCutClaimed  Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Barber {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  specialties String[]
  photoUrl    String?
  isActive    Boolean  @default(true)
  bookings    Booking[]
  reviews     Review[]
  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  durationMin Int
  price       Int
  imageUrl    String?
  isActive    Boolean  @default(true)
  bookings    Booking[]
  createdAt   DateTime @default(now())
}

model Booking {
  id         String   @id @default(cuid())
  customer   User     @relation(fields: [customerId], references: [id])
  customerId String
  barber     Barber   @relation(fields: [barberId], references: [id])
  barberId   String
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  status     Status   @default(PENDING)
  notes      String?
  totalPrice Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date, barberId])
  @@index([customerId, status])
}

model Membership {
  id              String       @id @default(cuid())
  user            User         @relation(fields: [userId], references: [id])
  userId          String       @unique
  tier            MemberTier
  startedAt       DateTime
  expiredAt       DateTime
  isActive        Boolean      @default(true)
  discountPercent Int
  createdAt       DateTime     @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  stock       Int      @default(0)
  imageUrl    String?
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderProduct {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  product    Product      @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  totalPrice Int
  status     OrderStatus  @default(PENDING)
  createdAt  DateTime     @default(now())
}

model Review {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int      @range(1, 5)
  comment   String?
  createdAt DateTime @default(now())
}

enum Role { CUSTOMER BARBER ADMIN }
enum Status { PENDING CONFIRMED CANCELLED COMPLETED }
enum MemberTier { BASIC_3BULAN PREMIUM_6BULAN VIP_12BULAN }
enum OrderStatus { PENDING PAID SHIPPED CANCELLED }
